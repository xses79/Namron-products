// Namron 4566702 Edge Thermostat External Converter v1.29
const ZIGBEE_EPOCH_OFFSET = 946684800;
const lastSyncMap = {}; // module-level cache for last sync time per device

function smartDateDecode(value) {
    if (!value) return null;
    try {
        if (value > 100000) {
            const s = String(value).padStart(6, "0");
            return `20${s.slice(0, 2)}-${s.slice(2, 4)}-${s.slice(4, 6)}`;
        }
        return new Date(946684800000 + value * 86400000).toISOString().slice(0, 10);
    } catch (_) { return null; }
}

function dateToYymmdd(value) {
    const match = String(value).match(/^20(\d{2})-(\d{2})-(\d{2})$/);
    if (!match) throw new Error(`Invalid date: ${value}. Use YYYY-MM-DD format, e.g. 2026-06-05.`);
    return Number(match[1] + match[2] + match[3]);
}

function deriveEdgeThermostatMode(frost, vacationMode, sensorMode, progOpMode, boostTimeSet) {
    if (frost === "ON") return "frost";
    if (vacationMode === "ON") return "holiday";
    if (sensorMode === "percent") return "regulator";
    if (boostTimeSet > 0) return "boost";
    if (progOpMode === 1) return "program";
    if (progOpMode === 2) return "eco";
    return "manual";
}

const edgeSensorModeLookup = {"0": "air", "1": "floor", "2": "both", "3": "air2", "4": "both2", "5": "floor_percent", "6": "percent"};
const edgeOnOffLookup = {OFF: 0, ON: 1};
const edgeOnOffReverseLookup = {"0": "OFF", "1": "ON"};
const edgeScreenOnTimeLookup = {"0": "always_on", "1": "10s", "2": "60s", "3": "30s"};
const edgeScreenOnTimeValueLookup = {always_on: 0, "10s": 1, "60s": 2, "30s": 3};

async function safeReadEdge(endpoint, cluster, attrs) {
    try { await endpoint.read(cluster, attrs); } catch (_) {}
}

async function writeEdgeHvac(entity, attr, value, type) {
    await entity.write("hvacThermostat", {[attr]: {value, type}});
}

const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

const fzEdge = {
    basic: {
        cluster: "genBasic",
        type: ["attributeReport", "readResponse"],
        convert: (model, msg) => {
            const result = {};
            if (msg.data["swBuildId"] !== undefined) result["firmware_version"] = msg.data["swBuildId"];
            if (msg.data["dateCode"] !== undefined) result["firmware_date"] = msg.data["dateCode"];
            return result;
        },
    },

    namron_private: {
        cluster: "hvacThermostat",
        type: ["attributeReport", "readResponse"],
        convert: (model, msg, publish, options, meta) => {
            const result = {};

            if (msg.data["localTemp"] !== undefined) result["local_temperature"] = msg.data["localTemp"] / 100;
            if (msg.data["occupiedHeatingSetpoint"] !== undefined) result["occupied_heating_setpoint"] = msg.data["occupiedHeatingSetpoint"] / 100;
            if (msg.data["localTemperatureCalibration"] !== undefined) result["local_temperature_calibration"] = msg.data["localTemperatureCalibration"] / 10;
            if (msg.data["systemMode"] !== undefined) {
                const map = {"0": "off", "1": "auto", "3": "cool", "4": "heat"};
                result["system_mode"] = map[String(msg.data["systemMode"])] ?? String(msg.data["systemMode"]);
            }
            if (msg.data["runningMode"] !== undefined) {
                const map = {"0": "off", "3": "cool", "4": "heat"};
                result["running_mode"] = map[String(msg.data["runningMode"])] ?? String(msg.data["runningMode"]);
            }
            if (msg.data["runningState"] !== undefined) {
                const map = {"0": "idle", "1": "heat", "2": "cool"};
                result["running_state"] = map[String(msg.data["runningState"])] ?? String(msg.data["runningState"]);
            }
            if (msg.data["pIHeatingDemand"] !== undefined) result["pi_heating_demand"] = msg.data["pIHeatingDemand"];
            if (msg.data["tempDisplayMode"] !== undefined) result["temperature_display_mode"] = msg.data["tempDisplayMode"] === 0 ? "celsius" : "fahrenheit";
            if (msg.data["keypadLockout"] !== undefined) result["keypad_lockout"] = msg.data["keypadLockout"] === 0 ? "unlock" : "lock";

            if (msg.data["programingOperMode"] !== undefined) {
                result["thermostat_program_mode"] = msg.data["programingOperMode"];
            }

            for (const [key, value] of Object.entries(msg.data)) {
                switch (Number(key)) {
                    case 0x8000: result["window_open_check"] = edgeOnOffReverseLookup[String(value)] ?? String(value); break;
                    case 0x8001: result["frost"] = edgeOnOffReverseLookup[String(value)] ?? String(value); break;
                    case 0x8002: result["window_state"] = value ? "open" : "closed"; break;
                    case 0x8003: result["work_days_raw"] = Number(value); break;
                    case 0x8004: result["sensor_mode"] = edgeSensorModeLookup[String(value)] ?? String(value); break;
                    case 0x8005: result["panel_brightness"] = value; break;
                    case 0x8007: result["regulator_cycle"] = value; break;
                    case 0x8013: result["holiday_temp_set"] = value / 100; break;
                    case 0x801c: result["regulation_mode_raw"] = Number(value); break;
                    case 0x801d: result["regulator_percentage"] = value; break;
                    case 0x801f: result["vacation_mode"] = edgeOnOffReverseLookup[String(value)] ?? String(value); break;
                    case 0x8020: result["vacation_start"] = smartDateDecode(value); break;
                    case 0x8021: result["vacation_end"] = smartDateDecode(value); break;
                    case 0x800a:
                        result["time_sync_flag"] = edgeOnOffReverseLookup[String(value)] ?? String(value);
                        if (value === 1) {
                const ts = Math.round(Date.now() / 1000) - ZIGBEE_EPOCH_OFFSET;
                            msg.endpoint.write("hvacThermostat", {0x800B: {value: ts, type: 0x23}})
                                .then(() => msg.endpoint.write("hvacThermostat", {0x800A: {value: 0, type: 0x10}}))
                                .then(() => msg.endpoint.read("hvacThermostat", [0x800B]))
                                .catch(() => {});
                        }
                        break;
                    case 0x800b:
                        try {
                            const d = new Date((value + ZIGBEE_EPOCH_OFFSET) * 1000);
                            result["time_sync_value"] = d.toISOString().replace("T", " ").slice(0, 19) + " UTC";
                        } catch (_) { result["time_sync_value"] = String(value); }
                        break;
                    case 0x8022: result["auto_time"] = edgeOnOffReverseLookup[String(value)] ?? String(value); break;
                    case 0x8023: result["boost_time_set"] = value; break;
                    case 0x8024: result["boost_time_remaining"] = value; break;
                    case 0x8025: result["max_heat_temp"] = value / 10; break;
                    case 0x8029: result["screen_on_time"] = edgeScreenOnTimeLookup[String(value)] ?? String(value); break;
                }
            }

            const merged = Object.assign({}, meta?.state ?? {}, result);
            const regulationMode = merged["regulation_mode_raw"] ?? 0;
            result["thermostat_mode"] = deriveEdgeThermostatMode(
                merged["frost"],
                merged["vacation_mode"],
                merged["sensor_mode"],
                regulationMode,
                merged["boost_time_set"] ?? 0,
            );
            return result;
        },
    },

    metering: {
        cluster: "seMetering",
        type: ["attributeReport", "readResponse"],
        convert: (model, msg) => {
            const result = {};
            if (msg.data["currentSummDelivered"] !== undefined) {
                const divisor = msg.data["divisor"] ?? 1000;
                const multiplier = msg.data["multiplier"] ?? 1;
                result["energy"] = (Number(msg.data["currentSummDelivered"]) * multiplier) / divisor;
            }
            return result;
        },
    },

    electrical: {
        cluster: "haElectricalMeasurement",
        type: ["attributeReport", "readResponse"],
        convert: (model, msg) => {
            const result = {};
            const cMul = msg.data["acCurrentMultiplier"] ?? 1;
            const cDiv = msg.data["acCurrentDivisor"] ?? 1000;
            if (msg.data["activePower"] !== undefined) result["power"] = msg.data["activePower"];
            if (msg.data["rmsCurrent"] !== undefined) result["current"] = (msg.data["rmsCurrent"] * cMul) / cDiv;
            return result;
        },
    },
};

const tzEdge = {
    thermostat_mode: {
        key: ["thermostat_mode"],
        convertSet: async (entity, key, value, meta) => {
            const state = {};
            const wasRegulator = meta.state?.["sensor_mode"] === "percent";
            switch (value) {
                case "manual":
                case "program":
                case "eco": {
                    await writeEdgeHvac(entity, 0x8001, 0, 0x10);
                    await writeEdgeHvac(entity, 0x801f, 0, 0x10);
                    if (wasRegulator) {
                        await writeEdgeHvac(entity, 0x8004, 1, 0x30);
                        state["sensor_mode"] = "floor";
                    }
                    await entity.read("hvacThermostat", ["programingOperMode"]);
                    const progMode = value === "manual" ? 0 : value === "program" ? 1 : 2;
                    await entity.write("hvacThermostat", {
                        programingOperMode: progMode,
                        0x801c: {value: progMode, type: 0x30},
                    });
                    // Read back to verify device accepted the change
                    await entity.read("hvacThermostat", ["programingOperMode", 0x801c]);
                    state["frost"] = "OFF";
                    state["vacation_mode"] = "OFF";
                    state["boost_time_set"] = 0;
                    state["regulation_mode_raw"] = progMode;
                    break;
                }
                case "regulator":
                    await writeEdgeHvac(entity, 0x8001, 0, 0x10);
                    await writeEdgeHvac(entity, 0x801f, 0, 0x10);
                    await writeEdgeHvac(entity, 0x8004, 6, 0x30);
                    state["frost"] = "OFF";
                    state["vacation_mode"] = "OFF";
                    state["sensor_mode"] = "percent";
                    state["boost_time_set"] = 0;
                    break;
                case "frost":
                    await writeEdgeHvac(entity, 0x801f, 0, 0x10);
                    await writeEdgeHvac(entity, 0x8001, 1, 0x10);
                    state["vacation_mode"] = "OFF";
                    state["frost"] = "ON";
                    state["boost_time_set"] = 0;
                    break;
                case "holiday":
                    await writeEdgeHvac(entity, 0x8001, 0, 0x10);
                    await writeEdgeHvac(entity, 0x801f, 1, 0x10);
                    state["frost"] = "OFF";
                    state["vacation_mode"] = "ON";
                    state["boost_time_set"] = 0;
                    break;
                case "boost": {
                    await writeEdgeHvac(entity, 0x8001, 0, 0x10);
                    await writeEdgeHvac(entity, 0x801f, 0, 0x10);
                    const hours = (meta.state?.["boost_time_set"] > 0) ? meta.state["boost_time_set"] : 1;
                    await writeEdgeHvac(entity, 0x8023, hours, 0x20);
                    state["frost"] = "OFF";
                    state["vacation_mode"] = "OFF";
                    state["boost_time_set"] = hours;
                    break;
                }
                default: throw new Error(`Invalid thermostat_mode: ${value}`);
            }
            state["thermostat_mode"] = value;
            return {state};
        },
        convertGet: async (entity) => {
            await entity.read("hvacThermostat", [0x8001, 0x8004, 0x801f, 0x8023, "programingOperMode"]);
        },
    },

    occupied_heating_setpoint: {
        key: ["occupied_heating_setpoint"],
        convertSet: async (entity, key, value) => {
            await entity.write("hvacThermostat", {occupiedHeatingSetpoint: Math.round(value * 100)});
            return {state: {occupied_heating_setpoint: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", ["occupiedHeatingSetpoint"]); },
    },

    system_mode: {
        key: ["system_mode"],
        convertSet: async (entity, key, value) => {
            const map = {off: 0, heat: 4};
            await entity.write("hvacThermostat", {systemMode: map[value]});
            return {state: {system_mode: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", ["systemMode"]); },
    },

    local_temperature_calibration: {
        key: ["local_temperature_calibration"],
        convertSet: async (entity, key, value) => {
            await entity.write("hvacThermostat", {localTemperatureCalibration: Math.round(value * 10)});
            return {state: {local_temperature_calibration: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", ["localTemperatureCalibration"]); },
    },

    temperature_display_mode: {
        key: ["temperature_display_mode"],
        convertSet: async (entity, key, value) => {
            await entity.write("hvacUserInterfaceCfg", {tempDisplayMode: value === "celsius" ? 0 : 1});
            return {state: {temperature_display_mode: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacUserInterfaceCfg", ["tempDisplayMode"]); },
    },

    frost: {
        key: ["frost"],
        convertSet: async (entity, key, value) => {
            if (value === "ON") {
                await entity.write("hvacThermostat", {0x801f: {value: 0, type: 0x10}});
                await entity.write("hvacThermostat", {0x8001: {value: 1, type: 0x10}});
            } else {
                await entity.write("hvacThermostat", {0x8001: {value: 0, type: 0x10}});
            }
            return {state: {frost: value}};
        },
    },

    keypad_lockout: {
        key: ["keypad_lockout"],
        convertSet: async (entity, key, value) => {
            const mapped = value === "lock" ? 1 : 0;
            await entity.write("hvacUserInterfaceCfg", {keypadLockout: mapped});
            return {state: {keypad_lockout: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacUserInterfaceCfg", ["keypadLockout"]); },
    },

    regulator_percentage: {
        key: ["regulator_percentage"],
        convertSet: async (entity, key, value) => {
            const num = Number(value);
            if (Number.isNaN(num) || num < 0 || num > 100) throw new Error(`Invalid regulator_percentage: ${value}`);
            await writeEdgeHvac(entity, 0x801d, Math.round(num), 0x29);
            return {state: {regulator_percentage: num}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x801d]); },
    },

    regulator_cycle: {
        key: ["regulator_cycle"],
        convertSet: async (entity, key, value) => {
            const num = Math.round(Number(value));
            if (Number.isNaN(num) || num < 1 || num > 30) throw new Error(`Invalid regulator_cycle: ${value}`);
            await writeEdgeHvac(entity, 0x8007, num, 0x20);
            return {state: {regulator_cycle: num}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8007]); },
    },

    max_heat_temp: {
        key: ["max_heat_temp"],
        convertSet: async (entity, key, value) => {
            const num = Number(value);
            if (Number.isNaN(num) || num < 15 || num > 35) throw new Error(`Invalid max_heat_temp: ${value}`);
            await writeEdgeHvac(entity, 0x8025, Math.round(num * 10), 0x29);
            return {state: {max_heat_temp: num}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8025]); },
    },

    vacation_start: {
        key: ["vacation_start"],
        convertSet: async (entity, key, value) => {
            await writeEdgeHvac(entity, 0x8020, dateToYymmdd(value), 0x23);
            return {state: {vacation_start: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8020]); },
    },

    vacation_end: {
        key: ["vacation_end"],
        convertSet: async (entity, key, value) => {
            await writeEdgeHvac(entity, 0x8021, dateToYymmdd(value), 0x23);
            return {state: {vacation_end: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8021]); },
    },

    holiday_temp_set: {
        key: ["holiday_temp_set"],
        convertSet: async (entity, key, value) => {
            const num = Number(value);
            if (Number.isNaN(num) || num < 5 || num > 35) throw new Error(`Invalid holiday_temp_set: ${value}`);
            await writeEdgeHvac(entity, 0x8013, Math.round(num * 100), 0x29);
            return {state: {holiday_temp_set: num}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8013]); },
    },

    boost_time_set: {
        key: ["boost_time_set"],
        convertSet: async (entity, key, value) => {
            const num = Math.round(Number(value));
            if (Number.isNaN(num) || num < 0 || num > 24) throw new Error(`Invalid boost_time_set: ${value}`);
            await writeEdgeHvac(entity, 0x8023, num, 0x20);
            return {state: {boost_time_set: num}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8023, 0x8024]); },
    },

    window_open_check: {
        key: ["window_open_check"],
        convertSet: async (entity, key, value) => {
            const raw = edgeOnOffLookup[value];
            if (raw === undefined) throw new Error(`Invalid window_open_check: ${value}`);
            await writeEdgeHvac(entity, 0x8000, raw, 0x10);
            return {state: {window_open_check: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8000]); },
    },

    screen_on_time: {
        key: ["screen_on_time"],
        convertSet: async (entity, key, value) => {
            const raw = edgeScreenOnTimeValueLookup[value];
            if (raw === undefined) throw new Error(`Invalid screen_on_time: ${value}`);
            await writeEdgeHvac(entity, 0x8029, raw, 0x30);
            return {state: {screen_on_time: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8029]); },
    },

    sensor_mode: {
        key: ["sensor_mode"],
        convertSet: async (entity, key, value, meta) => {
            const map = {air: 0, floor: 1, both: 2, air2: 3, both2: 4, floor_percent: 5, percent: 6};
            const raw = map[value];
            if (raw === undefined) throw new Error(`Invalid sensor_mode: ${value}`);
            await writeEdgeHvac(entity, 0x8004, raw, 0x30);
            const state = {sensor_mode: value};
            // Recompute thermostat_mode since sensor_mode affects it
            const merged = Object.assign({}, meta.state, {sensor_mode: value});
            state["thermostat_mode"] = deriveEdgeThermostatMode(
                merged["frost"],
                merged["vacation_mode"],
                value,
                merged["regulation_mode_raw"] ?? 0,
                merged["boost_time_set"] ?? 0,
            );
            return {state};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8004]); },
    },

    panel_brightness: {
        key: ["panel_brightness"],
        convertSet: async (entity, key, value) => {
            const num = Math.round(Number(value));
            if (Number.isNaN(num) || num < 0 || num > 100) throw new Error(`Invalid panel_brightness: ${value}`);
            await writeEdgeHvac(entity, 0x8005, num, 0x20);
            return {state: {panel_brightness: num}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8005]); },
    },

    auto_time: {
        key: ["auto_time"],
        convertSet: async (entity, key, value) => {
            const raw = edgeOnOffLookup[value];
            if (raw === undefined) throw new Error(`Invalid auto_time: ${value}`);
            await writeEdgeHvac(entity, 0x8022, raw, 0x10);
            return {state: {auto_time: value}};
        },
        convertGet: async (entity) => { await entity.read("hvacThermostat", [0x8022]); },
    },

    sync_time: {
        key: ["sync_time"],
        convertSet: async (entity) => {
const ts = Math.round(Date.now() / 1000) - ZIGBEE_EPOCH_OFFSET;
            await writeEdgeHvac(entity, 0x800b, ts, 0x23);
            await writeEdgeHvac(entity, 0x800a, 0, 0x10);
            await entity.read("hvacThermostat", [0x800a, 0x800b]);
            return {state: {sync_time: "sync"}};
        },
    },
};

