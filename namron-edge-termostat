        ];
    },

    configure: async (device, coordinatorEndpoint) => {
        const endpoint = device.getEndpoint(1);
        await endpoint.bind("genTime", coordinatorEndpoint);
        await endpoint.bind("hvacThermostat", coordinatorEndpoint);
        await endpoint.bind("hvacUserInterfaceCfg", coordinatorEndpoint);
        await endpoint.bind("msRelativeHumidity", coordinatorEndpoint);
        await endpoint.bind("seMetering", coordinatorEndpoint);
        await endpoint.bind("haElectricalMeasurement", coordinatorEndpoint);

        await safeReadEdge(endpoint, "genBasic", ["swBuildId", "dateCode"]);
        await safeReadEdge(endpoint, "hvacThermostat", [
            "localTemp", "occupiedHeatingSetpoint", "systemMode",
            "runningMode", "runningState", "localTemperatureCalibration",
            "pIHeatingDemand", "programingOperMode",
        ]);
        await safeReadEdge(endpoint, "hvacUserInterfaceCfg", ["keypadLockout", "tempDisplayMode"]);
        await safeReadEdge(endpoint, "seMetering", ["currentSummDelivered", "divisor", "multiplier"]);
        await safeReadEdge(endpoint, "haElectricalMeasurement", ["activePower", "rmsCurrent", "acCurrentMultiplier", "acCurrentDivisor"]);
        await safeReadEdge(endpoint, "hvacThermostat", [
            0x8000, 0x8001, 0x8002, 0x8003, 0x8004, 0x8005, 0x8007, 0x8013, 0x801c, 0x801d, 0x801f,
            0x8020, 0x8021, 0x800a, 0x800b, 0x8022, 0x8023, 0x8024, 0x8025, 0x8029,
        ]);

        // Configure reporting for time_sync_flag so device reports it periodically
        await safeReadEdge(endpoint, "hvacThermostat", [0x800a]);
        try {
            await endpoint.configureReporting("hvacThermostat", [{
                attribute: {ID: 0x800A, type: 0x10},
                minimumReportInterval: 60,
                maximumReportInterval: 300,
                reportableChange: 1,
            }]);
        } catch (_) {}

        const ts = Math.round(Date.now() / 1000) - ZIGBEE_EPOCH_OFFSET;
        await endpoint.write("hvacThermostat", {0x800b: {value: ts, type: 0x23}});
        await endpoint.write("hvacThermostat", {0x800a: {value: 0, type: 0x10}});

        device.powerSource = "Mains (single phase)";
        device.save();
    },

    onEvent: async (event, settings, state, publish) => {
        if (event.type === "stop") return;
        const device = event.data.device;
        const deviceId = device.ieeeAddr;
        const now = Date.now();
        const lastSync = lastSyncMap[deviceId] ?? 0;
        if (now - lastSync > 2 * 60 * 1000) {
            try {
                const endpoint = device.getEndpoint(1);
                const ts = Math.round(now / 1000) - ZIGBEE_EPOCH_OFFSET;
                await endpoint.write("hvacThermostat", {0x800b: {value: ts, type: 0x23}});
                await endpoint.write("hvacThermostat", {0x800a: {value: 0, type: 0x10}});
                lastSyncMap[deviceId] = now;
                const nowDate = new Date();
                const timeStr = nowDate.toISOString().replace("T", " ").slice(0, 19) + " UTC";
                if (typeof publish === "function") publish({time_sync_value: timeStr});
            } catch (_) {}
        }
    },
};

module.exports = [definition];
